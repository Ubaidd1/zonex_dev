{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/company",
      "destination": "/company/index.html"
    },
    {
      "source": "/company/",
      "destination": "/company/index.html"
    }
  ]
}
