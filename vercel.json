{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/home/?$",
      "status": 301,
      "headers": { "Location": "/" }
    },
    {
      "src": "/company",
      "dest": "/about/index.html"
    },
    {
      "src": "/company/",
      "dest": "/about/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
